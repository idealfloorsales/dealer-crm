{
  "expo": {
    "name": "IDEAL FLOOR CRM",
    "slug": "ideal-floor-crm",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "idealfloorcrm",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IDEAL FLOOR CRM использует геопозицию для маршрутов и работы с дилерами в поле."
        }
      ]
    ],
    "android": {
      "package": "kz.idealfloor.crm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B9040A"
      }
    },
    "ios": {
      "bundleIdentifier": "kz.idealfloor.crm",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
