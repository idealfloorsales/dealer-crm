{
  "expo": {
    "name": "IDEAL FLOOR CRM",
    "slug": "ideal-floor-crm",
    "version": "0.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "idealfloorcrm",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IDEAL FLOOR CRM использует геопозицию для маршрутов и работы с дилерами в поле."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "./plugins/with-stable-release.cjs"
    ],
    "android": {
      "package": "kz.idealfloor.crm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B9040A"
      },
      "versionCode": 3
    },
    "ios": {
      "bundleIdentifier": "kz.idealfloor.crm",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
